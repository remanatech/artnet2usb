{
  "name": "relackout-artnet2usb",
  "version": "0.2.0",
  "description": "Free Art-Net to USB DMX bridge for Enttec DMX USB Pro and Open DMX / FTDI interfaces, with a desktop GUI and a headless CLI",
  "main": "dist/main/main.js",
  "bin": {
    "artnet2usb-cli": "dist-cli/cli/index.js"
  },
  "author": "Remana <info@remana.tech> (https://relackout.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remanatech/artnet2usb.git"
  },
  "homepage": "https://relackout.com/usb-dmx",
  "bugs": {
    "url": "https://github.com/remanatech/artnet2usb/issues"
  },
  "keywords": [
    "art-net",
    "artnet",
    "dmx",
    "dmx512",
    "usb-dmx",
    "enttec",
    "ftdi",
    "open-dmx",
    "lighting-control",
    "stage-lighting"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:cli": "tsc --noEmit -p tsconfig.cli.json",
    "dist": "node scripts/build-standalone.mjs",
    "dist:mac": "node scripts/build-standalone.mjs --mac",
    "dist:win": "node scripts/build-standalone.mjs --win",
    "dist:linux": "node scripts/build-standalone.mjs --linux",
    "build:cli": "tsc -p tsconfig.cli.json",
    "dev:cli": "tsx cli/index.ts",
    "dist:standalone": "node scripts/build-standalone.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@fontsource/space-grotesk": "^5.2.10",
    "commander": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@yao-pkg/pkg": "^6.21.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.28.1",
    "postcss": "^8.4.49",
    "resedit": "^1.7.2",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "@serialport/bindings-cpp@12.0.1": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true
  },
  "build": {
    "appId": "tech.remana.relackout.artnet2usb",
    "productName": "Relackout ArtNet 2 USB",
    "npmRebuild": false,
    "files": [
      "dist/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icons"
    },
    "portable": {
      "artifactName": "Relackout-ArtNet2USB-${version}-portable.${ext}"
    },
    "appImage": {
      "artifactName": "Relackout-ArtNet2USB-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Relackout-ArtNet2USB-${version}-${arch}.${ext}"
    }
  }
}
